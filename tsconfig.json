{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@song-maker/score-engine": ["./packages/score-engine/src/index.ts"],
      "@song-maker/stem-providers": ["./packages/stem-providers/src/index.ts"],
      "@song-maker/mix-production": ["./packages/mix-production/src/index.ts"],
      "@song-maker/lora-packs": ["./packages/lora-packs/src/index.ts"],
      "@song-maker/partition-invariants": [
        "./packages/partition-invariants/src/index.ts"
      ],
      "@song-maker/project-sync": ["./packages/project-sync/src/index.ts"],
      "@song-maker/remote-worker": ["./packages/remote-worker/src/index.ts"],
      "@song-maker/akasha-declui": ["./packages/akasha-declui/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
