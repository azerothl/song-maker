{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Song Maker",
  "version": "0.1.0",
  "identifier": "com.songmaker.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Song Maker",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/song-maker/**",
          "$LOCALDATA/song-maker/**",
          "$DOCUMENT/**",
          "$HOME/Documents/**",
          "$HOME/OneDrive/Documents/**",
          "**/Song Maker/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
