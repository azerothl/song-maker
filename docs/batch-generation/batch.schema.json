{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Song Maker — fichier batch V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "songs"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "maxParallelGenerations": { "type": "integer", "minimum": 1, "maximum": 32 },
    "parallelismPolicy": { "enum": ["allowReduction", "requireRequested"] },
    "onError": { "enum": ["continue", "pause"] },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "defaults": { "$ref": "#/$defs/defaults" },
    "songs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/song" }
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tonic", "mode"],
      "properties": {
        "tonic": { "enum": ["C", "C#", "D", "Eb", "E", "F", "F#", "G", "Ab", "A", "Bb", "B"] },
        "mode": { "enum": ["major", "minor"] }
      }
    },
    "meter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer" },
        "denominator": { "type": "integer" }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generations": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "cot": { "enum": ["full", "melody", "off"] },
        "targetDurationSec": { "type": "integer", "minimum": 30, "maximum": 360 },
        "preferFullLyrics": { "type": "boolean" },
        "instrumentalMode": { "type": "boolean" },
        "singingLanguage": { "type": ["string", "null"] },
        "tempoBpm": { "type": ["integer", "null"] },
        "key": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/key" }] },
        "meter": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/meter" }] }
      }
    },
    "song": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "style", "lyrics"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "style": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "lyrics": { "type": "string", "maxLength": 4000 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "generations": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "cot": { "enum": ["full", "melody", "off"] },
        "targetDurationSec": { "type": "integer", "minimum": 30, "maximum": 360 },
        "preferFullLyrics": { "type": "boolean" },
        "instrumentalMode": { "type": "boolean" },
        "singingLanguage": { "type": ["string", "null"] },
        "tempoBpm": { "type": ["integer", "null"] },
        "key": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/key" }] },
        "meter": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/meter" }] }
      }
    }
  }
}
