# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Lockfiles: this repo is pnpm-only. A stray npm/yarn lockfile silently
# diverges from pnpm-lock.yaml and breaks `pnpm install --frozen-lockfile`.
package-lock.json
yarn.lock
pnpm-lock.yaml.*.yaml

node_modules/
dist/
dist-ssr
*.local
*.tsbuildinfo
coverage/
.pnpm-store/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# Phase 0 local cache (never commit models)
.cache/
.song-maker-mcp/

# Local NAR LoRA training jobs (manifests, logs, adapters)
training-jobs/*
!training-jobs/.gitkeep
__pycache__/
artifacts/

# BasicPitch trial: WAV excerpts are redundant with mp3 A/B (issue #169)
docs/basicpitch-trial/excerpts/*.wav

# Bench snapshots piano (#250) — générés localement, ne pas committer
bench/score-tab-*-piano-*.json
