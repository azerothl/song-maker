{
  "name": "song-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Song Maker — desktop app (phases 0–1) and monorepo packages (phases 2–4)",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "packages:build": "pnpm -r --filter \"./packages/**\" run build",
    "packages:test": "pnpm -r --filter \"./packages/**\" run test",
    "packages:typecheck": "pnpm -r --filter \"./packages/**\" run typecheck"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
